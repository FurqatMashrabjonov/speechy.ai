<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roadmap_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_roadmap"
    android:padding="16dp">

    <!-- Row 1: app name (top-left) + level (top-right) -->
    <TextView
        android:id="@+id/app_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="🎤  Speechy AI"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/roadmap_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:text="Lv 1"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Row 2: roadmap title -->
    <TextView
        android:id="@+id/roadmap_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/app_header"
        android:layout_marginTop="8dp"
        android:text="Interview Prep"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Row 3: step info -->
    <TextView
        android:id="@+id/roadmap_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/roadmap_title"
        android:layout_marginTop="2dp"
        android:text="Step 1 of 15"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <!-- Bottom: streak (left) + XP (right) -->
    <TextView
        android:id="@+id/roadmap_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:text="🔥 0 streak"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/roadmap_xp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text="⚡ 0 XP"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Progress bar: above bottom stats -->
    <ProgressBar
        android:id="@+id/roadmap_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_above="@id/roadmap_streak"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="7"
        android:progressDrawable="@drawable/widget_progress_roadmap"
        android:background="@drawable/widget_progress_roadmap_bg" />

</RelativeLayout>
