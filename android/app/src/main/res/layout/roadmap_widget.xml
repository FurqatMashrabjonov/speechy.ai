<?xml version="1.0" encoding="utf-8"?>
<!-- Full layout: 4×2 default. Shows everything. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_roadmap"
    android:padding="16dp">

    <!-- Header row: app name (left) + streak pill (right) -->
    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎤 Speechy AI"
            android:textColor="#88FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_streak_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0 day streak"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Track name: below header -->
    <TextView
        android:id="@+id/track_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_row"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Interview Prep"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Step label: below track name -->
    <TextView
        android:id="@+id/step_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/track_name"
        android:layout_marginTop="2dp"
        android:text="Step 1 of 15"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <!-- Continue CTA: pinned to bottom -->
    <LinearLayout
        android:id="@+id/cta_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_btn_continue"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶  Continue Practice"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dot progress: above CTA -->
    <LinearLayout
        android:id="@+id/dots_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/cta_row"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dots_filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/dots_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○○○○○○○○○○○○○○○"
            android:textColor="#33FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.2" />
    </LinearLayout>

</RelativeLayout>
